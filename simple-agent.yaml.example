# simple-agent 配置示例（YAML）
#
# 复制为 simple-agent.yaml 后按需修改：
#   · 当前目录的 simple-agent.yaml 优先；
#   · 其次是用户配置目录（Windows: %APPDATA%\simple-agent\simple-agent.yaml）。
# 配置优先级（后者覆盖前者）：内置默认 → 本文件 → 环境变量 → 命令行参数。
# 旧版的 simple-agent.toml 仍然能读（按扩展名选择解析器）。

# 启动时使用的提供商与模型。留空则用第一个「有凭据」的提供商。
# 想用本地 Ollama（默认不会自动选中）：填 ollama 与模型名。
# active_provider: deepseek
# active_model: deepseek-chat

# 界面语言：auto（默认，跟随系统）/ zh / en。
# dsh 里已有的文案直接用它的中英两套；其余按同样风格翻译。
# language: auto

# 追加在默认系统提示之后的内容。
# system_prompt: "回答尽量简短，先给结论。"

# 权限档位（界面输入卡左下角的「完全权限 / 工作区内修改」）。
#
# allow_shell 是**唯一**的权限开关，两档的含义：
#   · false（默认，工作区内修改）：不注册 bash/pwsh；read/write/edit/glob/grep 等
#     路径工具限制在工作区内，绝对路径与 `..` 逃逸一律拒绝（还会校验符号链接/junction）。
#   · true（完全权限）：注册 bash/pwsh；路径工具**不再限制工作目录**，绝对路径与
#     `..` 都接受，`working_directory` 可以切到任意目录。
#     理由：能跑任意命令的会话本来就能访问任何文件，再把文件工具关在工作区里只是
#     让模型绕路走 shell。
#
# 也能用 --allow-shell 或 SIMPLE_AGENT_ALLOW_SHELL=1 打开。
allow_shell: false

# 关闭 web_fetch（联网抓取网页正文并转成 markdown 交给模型）。
#
# 默认 **开启**：抓取不需要凭据、也不执行任何东西，与命令执行不是一个量级的风险。
# 不想让模型联网时把它设为 true（等价于启动参数 --no-web）。
# 行为要点：只支持 http/https；只跟随同源跳转（跨站跳转要模型自己重新请求）；
# 单次最多读 5MB / 10 万字符（超出截断并提示）；不支持需要 JavaScript 或登录的页面，
# 也不支持 PDF；返回内容前会显式声明"这是外部不可信内容"。
# disable_web_fetch: true

# 联网搜索（web_search）走 DeepSeek Search API，需要 DEEPSEEK_API_KEY。
#
# 没配 Key 时 **web_search 不会被注册**（模型看不到这个工具，也就不会去调，
# 免得每次报"没配 Key"）；web_fetch 不受影响——抓取走普通 HTTP，不需要凭据。
# Key 只从环境变量读，不写在这个文件里：
#   PowerShell：$env:DEEPSEEK_API_KEY = "sk-..."      （当前会话）
#   cmd：       set DEEPSEEK_API_KEY=sk-...           （当前窗口）
# 设置后要重启 simple-agent 才生效。
#
# 行为要点：一次最多 10 个查询（并发发出、结果轮转合并、按 URL 去重，最多 10 条来源）；
# 单次请求受服务端 5 QPS 限制；返回摘要与链接，正文需要 web_fetch 再抓。

# 一次用户输入内最多几轮工具调用（0 表示不限）。防止模型无限调用工具。
max_tool_rounds: 12

# 工具的工作区根目录。默认是启动时的当前目录；所有路径都不能逃出这里。
# workspace: F:/work/my-project

# 会话数据目录。默认按平台取（Windows 用 %APPDATA%\simple-agent）。
# data_dir: D:/simple-agent-data

# 覆盖或新增提供商。只写想改的字段即可，其余保持内置值。
providers:
  # 示例：用公司/内网网关（OpenAI 兼容）
  # paperhub:
  #   label: PaperHub
  #   base_url: https://tc-paperhub.diezhi.net/v1
  #   api_key_env: PAPERHUB_API_KEY
  #   # 这家厂商所有模型共用的请求体参数（模型自身的同名参数优先）
  #   # extra_body:
  #   #   reasoning_effort: low
  #   models:
  #     - id: deepseek-v4.1-flash
  #       label: DeepSeek V4.1 Flash   # 可选：界面上的显示名
  #       context_window: 128K
  #       max_output: 64K
  #       reasoning_efforts: [off, low, medium, high]
  #       reasoning_effort: medium     # 其余键原样进请求体
  #       vision: true                 # 支持图片输入（不写 = 不支持，禁止发图）
  #     - id: glm-5.3
  #       label: GLM-5.3
  #       context_window: 200K
  #       max_output: 128K
  #       reasoning_efforts: [low, high, max]   # 始终思考，没有「关闭」
  #
  # 也支持旧的裸字符串写法（等价于只写 id）：
  #   models:
  #     - deepseek-chat

  # 示例：覆盖内置提供商的部分字段
  # deepseek:
  #   base_url: https://api.deepseek.com/v1
  #   models:
  #     - id: deepseek-chat
  #       context_window: 64000
  #     - id: deepseek-reasoner
  #       context_window: 64000

# ---- 传输加密（可选，默认关闭）----
#
# 开启后 relay/执行端与展示端之间走 TLS。客户端不用 CA，只认写死的证书指纹：
# 等价于"只信任这一台 relay"，比 CA 链更严格。
#
# 首次启用时如果证书文件不存在会自动生成自签证书，并用
#   simple-agent --tls-cert <证书> --tls-key <私钥> --tls-print-fingerprint
# 打印出要填到客户端的指纹。
#
# tls:
#   # 服务端开关：证书自动生成到 <data_dir>/tls/ 并复用（等价于命令行 --tls）
#   enable: true
#   # 想放到别的位置再填这两项（不填就用上面的默认位置）
#   cert_file: /var/lib/simple-agent/tls/cert.pem
#   key_file: /var/lib/simple-agent/tls/key.pem
#   # 客户端（只填要连的那台 relay 的指纹；十六进制，可带冒号）
#   # fingerprint: 1207b163d52f2ed9dc4ff94334f683787c7a7fc7076dfbc3178eced586b86161
